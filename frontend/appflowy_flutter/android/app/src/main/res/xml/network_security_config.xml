<?xml version="1.0" encoding="utf-8"?>
<!--
  The built-in office and drawing (Excalidraw) editors are served to a WebView
  over plain HTTP on the loopback interface (see office_embedded_host.dart and
  excalidraw_host.dart). Cleartext is allowed for that address only; every
  other host keeps the platform default, which refuses cleartext.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
