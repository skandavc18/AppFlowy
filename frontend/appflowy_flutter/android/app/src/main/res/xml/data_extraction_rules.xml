<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device transfer on Android 12 and newer. Everything is included
  as before, except the office editor unpacked from the APK (about 400 MB),
  which the app recreates on its own.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="office_editor" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="office_editor" />
    </device-transfer>
</data-extraction-rules>
